# ==============================================================
# BRUNO LAVA CAR - MODELO DE CONFIGURAÇÃO DE AMBIENTE
# Copie este arquivo para .env e ajuste os valores conforme o ambiente
# ==============================================================

# Configurações da Aplicação
NODE_ENV=development
PORT=3333
API_BASE_URL=http://localhost:3333
WEB_BASE_URL=http://localhost:5173

# PostgreSQL 17 (Banco Principal)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lavacar_admin
DATABASE_PASSWORD=lavacar_dev_password
DATABASE_NAME=bruno_lava_car
DATABASE_URL=postgresql://lavacar_admin:lavacar_dev_password@localhost:5432/bruno_lava_car?schema=public

# Redis 7 (Locks de Concorrência e Filas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=lavacar_redis_password
REDIS_URL=redis://:lavacar_redis_password@localhost:6379

# Uploads / Armazenamento de Fotos (Diretório local ou Cloudflare R2 / S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Driver de Notificações WhatsApp ('mock' para dev, 'evolution' ou 'meta' para prod)
WHATSAPP_DRIVER=mock
WHATSAPP_API_URL=http://localhost:8082
WHATSAPP_API_TOKEN=mock_dev_token
PIX_KEY=contato@brunolavacar.com.br
